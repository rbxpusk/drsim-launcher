{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "launcher",
  "description": "The launcher window: its own commands and window controls.",
  "windows": ["launcher"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-is-focused",
    "core:window:allow-set-always-on-top",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "allow-launcher-state",
    "allow-check",
    "allow-sync",
    "allow-verify",
    "allow-cancel-sync",
    "allow-play",
    "allow-prewarm",
    "allow-notes",
    "allow-set-setting",
    "allow-pick-install-dir",
    "allow-clear-cache",
    "allow-open-link",
    "allow-desktop-shortcut",
    "allow-quit-app",
    "allow-install-launcher-update"
  ]
}
